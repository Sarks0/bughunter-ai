    { "name": "EXPLOITATION", "blocking": false, "agents": ["RCEAgent", "SSRFAgent"], "tools": ["pacu"], "gates": [], "max_concurrent_agents": 2 },
    { "name": "REPORT", "blocking": true, "agents": [], "tools": ["generate-report"], "gates": [] }
